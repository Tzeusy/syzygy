{
  "schemaVersion": 1,
  "policyId": "polaris-butlers-project-shape-secrets",
  "policyVersion": "1.0.0-candidate.1",
  "status": "candidate-unapproved",
  "scope": {
    "observingProject": "project:syzygy",
    "observedRepository": "repository:butlers-configured-poc",
    "contentClass": "declared-project-shape-text",
    "ingestBoundaries": [
      "observation",
      "model",
      "cache",
      "log",
      "human-html",
      "machine-json",
      "walkthrough-record"
    ]
  },
  "accessBoundary": {
    "postgresql": false,
    "credentialApi": false,
    "processEnvironment": false,
    "workingTree": false,
    "untrackedFiles": false,
    "observedCodeExecution": false,
    "networkEgress": false
  },
  "sourceAdmission": {
    "requiresRevisionBoundSourceManifest": true,
    "manifestRule": "manifest must validate against the signed PWB source grammar; it is not a separate owner-approved artifact",
    "gitObjectsOnly": true,
    "allowedTextEncodings": ["utf-8"],
    "deniedPathBasenames": [
      ".env",
      ".env.local",
      ".env.production",
      "credentials.json",
      "secrets.json",
      "id_rsa",
      "id_ed25519"
    ],
    "deniedPathPrefixes": [".env."],
    "deniedPathSuffixes": [".pem", ".key", ".p12", ".pfx"],
    "pathRuleScope": "apply basename and prefix rules to the final segment, and suffix rules to the complete final segment, of each normalized repository-relative path",
    "unclassifiableAction": "exclude-whole-artifact"
  },
  "detectors": [
    {
      "id": "private-key-material",
      "kind": "literal-fragment",
      "values": [
        "-----BEGIN PRIVATE KEY-----",
        "-----BEGIN RSA PRIVATE KEY-----",
        "-----BEGIN OPENSSH PRIVATE KEY-----"
      ]
    },
    {
      "id": "known-token-formats",
      "kind": "regular-expression",
      "pattern": "(?:AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,})",
      "flags": "g"
    },
    {
      "id": "credential-assignment",
      "kind": "regular-expression",
      "pattern": "(?:password|passwd|secret|token|api[_-]?key|client[_-]?secret)\\s*[:=]\\s*[\\\"']?[^\\s\\\"'<>$]{8,}",
      "flags": "gi"
    },
    {
      "id": "credential-bearing-url",
      "kind": "regular-expression",
      "pattern": "https?://[^/@\\s]+:[^/@\\s]+@",
      "flags": "gi"
    }
  ],
  "matchAction": {
    "action": "exclude-whole-artifact",
    "redactionClass": "excluded-artifact",
    "retainedFields": [
      "contentDigest",
      "repositoryRelativePath",
      "policyId",
      "policyVersion",
      "detectorId"
    ],
    "retainBody": false
  },
  "classificationOrder": [
    "verify exact Git-object and revision-bound-manifest membership against the signed PWB grammar",
    "reject denied path or unsupported encoding",
    "run every detector over transient bytes before parsing",
    "parse only the closed extraction class assigned by the manifest",
    "exclude the whole artifact on any match, NUL byte, strict UTF-8 failure, unknown extraction class, parse failure or resource-limit failure",
    "admit only parsed project-shape facts"
  ],
  "classificationSuccess": "a body is classifiable only when its normalized path is admitted, it decodes as strict UTF-8 without NUL, no detector matches, its manifest extraction class is in the signed PWB closed set, and that extractor completes within declared limits",
  "rawBodyHandling": {
    "storage": "never",
    "logging": "never",
    "rendering": "never",
    "machineResponse": "never",
    "externalEgress": "never"
  }
}
