+  "    timeout 400 npx vitest run --config packages/cap1-system/vitest.config.ts packages/cap1-system/src \\",
+  "    --reporter=default --reporter=/tmp/laneb-431/sysprobe/reporter.mjs --testTimeout=600000 --hookTimeout=600000 \\",
+  "    > /tmp/laneb-431/sysprobe/run-$i.log 2>&1",
+  "  code=$?",
+  "  echo \"run $i exit $code\"",
+  "  [ $code -ne 0 ] && break",
+  "done"
+ ],
