  "cutText": "function outsideFences(text) {\n    let open = null;\n    const unfenced = text.split('\\n').map(line => {\n        const m = /^ {0,3}(`{3,}|~{3,})(.*)$/.exec(line);\n        if (open === null) {\n            if (m !== null && !(m[1][0] === '`' && m[2].includes('`'))) {\n                open = m[1];\n                return '';\n            }\n            return line;\n        }\n        if (m !== null && m[1][0] === open[0] && m[1].length >= open.length && m[2].trim() === '')\n            open = null;\n        return '';\n    }).join('\\n');\n    return unfenced.replace(/<!--[\\s\\S]*?(?:-->|$)/g, comment => comment.replace(/[^\\n]/g, ''));\n}",
  "cutSha256": "d43b89ad0ed3efae40304f469300c62b93ee02617c42f705a511d37bc9b9f47a"
 },
