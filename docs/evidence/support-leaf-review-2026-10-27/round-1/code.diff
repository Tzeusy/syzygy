+import { describe, expect, it } from 'vitest';
+import { deepFreeze } from './deep-freeze.js';
+
+describe('deepFreeze', () => {
+  it('returns the value it was given and freezes every object it reaches', () => {
+    const value = { a: { b: [{ c: 1 }, 2] }, d: 'text' };
+    const returned = deepFreeze(value);
+    expect(returned).toBe(value);
+    expect(Object.isFrozen(value)).toBe(true);
+    expect(Object.isFrozen(value.a)).toBe(true);
+    expect(Object.isFrozen(value.a.b)).toBe(true);
+    expect(Object.isFrozen(value.a.b[0])).toBe(true);
+  });
+
+  it('passes primitives, null and undefined through', () => {
+    expect(deepFreeze(7)).toBe(7);
+    expect(deepFreeze('s')).toBe('s');
+    expect(deepFreeze(null)).toBeNull();
+    expect(deepFreeze(undefined)).toBeUndefined();
+  });
+
+  it('ends the walk at an object that is already frozen', () => {
+    const inner = { x: 1 };
+    const shell = Object.freeze({ inner });
+    deepFreeze(shell);
+    expect(Object.isFrozen(inner)).toBe(false);
+  });
+
+  it('terminates on a cycle', () => {
+    const node: { self?: unknown } = {};
+    node.self = node;
+    deepFreeze(node);
+    expect(Object.isFrozen(node)).toBe(true);
+  });
+
+  it('makes a later write fail', () => {
+    const value = deepFreeze({ list: [1] });
+    expect(() => { (value.list as number[]).push(2); }).toThrow(TypeError);
+  });
+});
diff --git a/packages/support/src/deep-freeze.ts b/packages/support/src/deep-freeze.ts
new file mode 100644
index 00000000..1e7ee38d
--- /dev/null
+++ b/packages/support/src/deep-freeze.ts
@@ -0,0 +1,13 @@
+/**
+ * Freezes the value and everything it reaches through own enumerable
+ * properties. An object that is already frozen ends the walk there, so a
+ * frozen shell around an unfrozen member keeps the member unfrozen, and a
+ * cycle terminates.
+ */
+export function deepFreeze<T>(value: T): T {
+  if (value !== null && typeof value === 'object' && !Object.isFrozen(value)) {
+    Object.freeze(value);
+    for (const member of Object.values(value)) deepFreeze(member);
+  }
+  return value;
+}
